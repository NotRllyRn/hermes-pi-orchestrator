{
  "name": "@notrllyrn/pi-dashboard-orchestrator-plugin",
  "version": "0.2.0",
  "description": "Minimal Server C primitives for Hermes orchestration through PI Dashboard",
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/server/index.ts",
      "default": "./src/server/index.ts"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "default": "./src/server/index.ts"
    }
  },
  "pi-dashboard-plugin": {
    "id": "hermes-pi-orchestrator",
    "displayName": "Hermes Pi Orchestrator",
    "priority": 100,
    "server": "./src/server/index.ts",
    "configSchema": "./src/configSchema.json",
    "claims": []
  },
  "dependencies": {
    "@blackbelt-technology/dashboard-plugin-runtime": "^0.8.0",
    "@blackbelt-technology/pi-dashboard-shared": "^0.8.0"
  },
  "scripts": {
    "test": "HOME=$(mktemp -d -t pi-orchestrator-test-XXXXXX) vitest run",
    "lint": "tsc --noEmit"
  }
}
