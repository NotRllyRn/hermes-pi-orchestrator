{
  "name": "@notrllyrn/pi-dashboard-orchestrator-plugin",
  "version": "0.8.0",
  "description": "Hermes-controlled Pi orchestration surfaces for PI Dashboard",
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/client/index.tsx",
      "default": "./src/client/index.tsx"
    },
    "./client": {
      "types": "./src/client/index.tsx",
      "default": "./src/client/index.tsx"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "default": "./src/server/index.ts"
    },
    "./bridge": {
      "types": "./src/bridge/index.ts",
      "default": "./src/bridge/index.ts"
    }
  },
  "pi-dashboard-plugin": {
    "id": "hermes-pi-orchestrator",
    "displayName": "Hermes Pi Orchestrator",
    "priority": 100,
    "client": "./src/client/index.tsx",
    "server": "./src/server/index.ts",
    "bridge": "./src/bridge/index.ts",
    "configSchema": "./src/configSchema.json",
    "claims": [
      {
        "slot": "sidebar-folder-section",
        "component": "FolderOrchestratorSection"
      },
      {
        "slot": "shell-overlay-route",
        "component": "OrchestratorPanel",
        "path": "/folder/:encodedCwd/orchestrator",
        "depth": 2,
        "parentPath": "/folder/:encodedCwd",
        "presentation": "page"
      }
    ]
  },
  "dependencies": {
    "@blackbelt-technology/dashboard-plugin-runtime": "^0.8.0",
    "@blackbelt-technology/pi-dashboard-shared": "^0.8.0",
    "@mdi/js": "^7.4.47"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "wouter": ">=3.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "wouter": "^3.9.0"
  },
  "scripts": {
    "test": "HOME=$(mktemp -d -t pi-orchestrator-test-XXXXXX) vitest run",
    "lint": "tsc --noEmit"
  }
}
