# Server B: inherited by the long-running Hermes gateway process.
# Local end of the SSH forward to Server C's loopback-only Dashboard.
PI_DASHBOARD_URL=http://127.0.0.1:18000

# Same 32-byte random secret on Server B and Server C.
# Generate once with: openssl rand -hex 32
PI_ORCHESTRATOR_AUTH_SECRET=replace-with-a-long-random-secret
